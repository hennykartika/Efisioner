# Copy to .env and fill in real values. Never commit .env.

# local | production. Production refuses to start with APP_DEBUG=true.
APP_ENV=production
APP_DEBUG=false
# Full public URL, including a sub-directory if the app does not live at the web root.
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=efisioner
# Use the least-privilege account from database/app-user.sql, not root.
DB_USERNAME=efisioner_app
DB_PASSWORD=

# Midtrans Dashboard > Settings > Access Keys. Sandbox keys start with "SB-".
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Fixed fee (IDR) added to every survey payment.
PLATFORM_FEE=1000
